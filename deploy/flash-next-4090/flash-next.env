# Defaults for the local model server on an RTX 4090 + 64 GB box: Qwen3.8-Flash-Next (uncensored, AD-4.27) and, optionally, Qwen3.8-27B.
# Override any of these in flash-next.local.env next to this file (git-ignored) instead of editing here.

# Where the llama.cpp checkout and the model live. Put this on the NVMe drive: the N-gram table is read from it at run time.
FLASHNEXT_HOME="${FLASHNEXT_HOME:-$HOME/flash-next}"

# llama.cpp revision to build: a branch, tag or commit, or pr/NNNNN for an open pull request.
LLAMA_REF="${LLAMA_REF:-master}"
CUDA_ARCH="${CUDA_ARCH:-89}"                        # 89 = Ada (RTX 4090)
INSTALL_CUDA="${INSTALL_CUDA:-0}"                   # 1 = `setup.sh deps` installs cuda-toolkit-12-8 from NVIDIA's apt repo if nvcc is missing

# Model
HF_REPO="${HF_REPO:-Navin-Models/Qwen3.8-Flash-Next-Uncensored-AD-4.27-GGUF}"
MODEL_DIR="${MODEL_DIR:-$FLASHNEXT_HOME/models/Qwen3.8-Flash-Next-Uncensored-AD-4.27}"
MODEL_SET="${MODEL_SET:-}"                          # substring picking one GGUF set when the repo holds several (e.g. the experimental MTP variant)
WITH_VISION="${WITH_VISION:-0}"                     # 1 = also download and load the mmproj vision projector (costs VRAM; Huntun does not need it)

# Server
ALIAS="${ALIAS:-qwen3.8-flash-next-uncensored}"     # the model name clients (Huntun) send
HOST="${HOST:-0.0.0.0}"                             # listen on the LAN so the Mac mini can reach it; firewall it to that machine
PORT="${PORT:-8080}"
API_KEY="${API_KEY:-}"                              # required key for every client; `setup.sh apikey` generates one into flash-next.local.env

# Two parallel slots, as in the reference plan ("双并发"). -c is split evenly across slots.
PARALLEL="${PARALLEL:-2}"
CTX_PER_SLOT="${CTX_PER_SLOT:-65536}"
KV_UNIFIED="${KV_UNIFIED:-0}"                       # 1 = the slots share one pool of PARALLEL*CTX_PER_SLOT; any slot may use all of it
KV_TYPE="${KV_TYPE:-q8_0}"                          # ~13 KB per token of context on this model at q8_0

THREADS="${THREADS:-auto}"                          # auto = physical cores (12 on a Ryzen 9 5900X)
# Prompt batch size. "auto" keeps context x batch at 64K x 4096: this model's sparse-attention scorer reserves a
# context x batch float table in VRAM (1 GiB at 64K x 4096, 4 GiB at 256K x 4096), and every GiB it takes pushes
# experts into RAM and slows decode (256K with 4096 measured 5 tok/s instead of 17). Smaller batches cost some prefill.
BATCH="${BATCH:-auto}"
UBATCH="${UBATCH:-auto}"
FIT_TARGET_MIB="${FIT_TARGET_MIB:-512}"             # VRAM headroom --fit leaves free; raise it if a desktop session shares the GPU
CACHE_RAM_MIB="${CACHE_RAM_MIB:-4096}"              # host-RAM prompt cache; RAM is tight on 64 GB, the page cache needs the rest
REASONING_BUDGET="${REASONING_BUDGET:-8192}"        # cap on thinking tokens per turn; -1 = unlimited

# Qwen's recommended sampling for this model family.
SAMPLING_ARGS="${SAMPLING_ARGS:---temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0}"
EXTRA_ARGS="${EXTRA_ARGS:-}"                        # anything else to pass to llama-server for Flash-Next

# Second model: Qwen3.8-27B (uncensored, Q4_K_M, ~17 GB). It fits entirely in VRAM, so it is much faster than Flash-Next
# (measured here: ~44 tok/s, ~83 total for two sessions, prefill ~2,800 t/s) but less capable. `./setup.sh download 27b` fetches it.
# Once both models are downloaded, the server offers both under the same address and API key and loads whichever a
# request names; the GPU holds one at a time, so switching costs a reload (seconds for this one, a minute or more for
# Flash-Next).
Q27_HF_REPO="${Q27_HF_REPO:-orcarouter/Qwen3.8-27B-Uncensored-GGUF}"
Q27_MODEL_DIR="${Q27_MODEL_DIR:-$FLASHNEXT_HOME/models/Qwen3.8-27B-Uncensored}"
Q27_MODEL_SET="${Q27_MODEL_SET:-Q4_K_M}"            # Q5_K_M (19.5 GB) is closer to Q8 but leaves room for ~64K of context only
Q27_ALIAS="${Q27_ALIAS:-qwen3.8-27b-uncensored}"
Q27_PARALLEL="${Q27_PARALLEL:-3}"                   # dense and all in VRAM: a session costs little speed (2 measured 43.5 tok/s each)
Q27_CTX_PER_SLOT="${Q27_CTX_PER_SLOT:-65536}"
Q27_KV_UNIFIED="${Q27_KV_UNIFIED:-1}"               # the three sessions share 192K, about what VRAM holds next to the weights
Q27_KV_TYPE="${Q27_KV_TYPE:-q4_0}"                  # ~18 KB per token (16 of 64 layers keep one); q8_0 doubles it
Q27_BATCH="${Q27_BATCH:-}"                          # empty = llama.cpp's defaults (2048 / 512)
Q27_UBATCH="${Q27_UBATCH:-}"
Q27_MTP="${Q27_MTP:-0}"                             # 1 = draft with the model's built-in MTP head (reported +30-40% decode); compare with bench.py
Q27_MTP_DRAFT="${Q27_MTP_DRAFT:-3}"
Q27_EXTRA_ARGS="${Q27_EXTRA_ARGS:-}"

# Which downloaded models to serve ("auto" = all of them, or e.g. "27b" or "flash-next,27b"), and which one to load
# at startup when there are several.
SERVE_MODELS="${SERVE_MODELS:-auto}"
DEFAULT_MODEL="${DEFAULT_MODEL:-flash-next}"
